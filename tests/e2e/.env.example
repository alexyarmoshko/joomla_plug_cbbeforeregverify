# Copy to .env (git ignores it) and set the values for your test site.

# Site root, without a trailing slash. Use the URL the site's configuration expects.
E2E_BASE_URL=https://example.ddev.site:8443

# CB registration page, relative to E2E_BASE_URL. Starts with "/".
E2E_REGISTER_PATH=/index.php?option=com_comprofiler&view=registers

# Mailpit web UI root, without a trailing slash. `ddev describe` shows it.
E2E_MAILPIT_URL=https://example.ddev.site:8026

# DDEV project directory of the test site. The tests run `ddev mysql` and `ddev exec` there.
E2E_DDEV_DIR=/path/to/ddev-project

# Joomla table prefix.
E2E_DB_PREFIX=jos_

# Registration fields the site requires beyond username, email, password, first and last name.
# JSON object of CSS selector -> value: text for inputs, option value for selects, true for checkboxes.
# Keep the single quotes: without them, the .env parser reads "#" as the start of a comment.
E2E_REG_FIELDS='{"#cb_expcomp":"Beginner","#cb_expyears":"1","#cb_gender":"Male","#acceptedterms":true}'

# Optional: a button to click after a successful registration, e.g. to skip payment.
E2E_AFTER_REGISTER_CLICK=button[title="Pay us offline"]

# Milliseconds to wait on the registration form before submitting. Must exceed the
# CB AntiSpam timer (captcha_timer_duration, in seconds).
E2E_FORM_DELAY_MS=3500
