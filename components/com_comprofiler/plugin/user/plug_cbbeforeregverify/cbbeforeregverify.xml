<?xml version="1.0" encoding="UTF-8"?>
<cbinstall version="1.0.0" type="plugin" group="user">
	<name>Yak Shaver CB Before Registration Email Verify</name>
	<author>Yak Shaver</author>
	<creationDate>2026-02</creationDate>
	<copyright>(C) 2026 Yak Shaver https://www.kayakshaver.com</copyright>
	<license>GNU General Public License version 2 or later</license>
	<authorEmail>me@kayakshaver.com</authorEmail>
	<description>Pre-registration email verification gateway for CB user registration form.</description>
	<version>2.11.0</version>
	<release>0.1.0</release>
	<scriptfile>install.cbbeforeregverify.php</scriptfile>
	<files>
		<filename plugin="cbbeforeregverify">cbbeforeregverify.php</filename>
		<filename>component.cbbeforeregverify.php</filename>
		<filename>cbbeforeregverify.xml</filename>
		<filename>install.cbbeforeregverify.php</filename>
		<filename>index.html</filename>
		<foldername>language</foldername>
		<foldername>library</foldername>
		<foldername>templates</foldername>
	</files>
	<params>
		<tabpane name="beforeregverify">
			<tabpanetab label="CBBEFOREREGVERIFY_TAB_GENERAL">
				<param name="gateway_enabled" type="yesno" default="1" label="CBBEFOREREGVERIFY_PARAM_GATEWAY_ENABLED_LABEL" description="CBBEFOREREGVERIFY_PARAM_GATEWAY_ENABLED_DESC" yes="CBBEFOREREGVERIFY_OPTION_ENABLE" no="CBBEFOREREGVERIFY_OPTION_DISABLE" />
				<param name="verification_ttl_sec" type="int" default="900" size="10" label="CBBEFOREREGVERIFY_PARAM_VERIFICATION_TTL_SEC_LABEL" description="CBBEFOREREGVERIFY_PARAM_VERIFICATION_TTL_SEC_DESC" />
				<param name="code_length" type="int" default="6" size="5" label="CBBEFOREREGVERIFY_PARAM_CODE_LENGTH_LABEL" description="CBBEFOREREGVERIFY_PARAM_CODE_LENGTH_DESC" />
				<param name="secret" type="text" default="" size="60" label="CBBEFOREREGVERIFY_PARAM_SECRET_LABEL" description="CBBEFOREREGVERIFY_PARAM_SECRET_DESC" />
				<param name="purge_after_days" type="int" default="30" size="5" label="CBBEFOREREGVERIFY_PARAM_PURGE_AFTER_DAYS_LABEL" description="CBBEFOREREGVERIFY_PARAM_PURGE_AFTER_DAYS_DESC" />
			</tabpanetab>
			<tabpanetab label="CBBEFOREREGVERIFY_TAB_IP_RATE_LIMITS">
				<param name="rl_ip_enabled" type="yesno" default="1" label="CBBEFOREREGVERIFY_PARAM_RL_IP_ENABLED_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_IP_ENABLED_DESC" yes="CBBEFOREREGVERIFY_OPTION_ENABLE" no="CBBEFOREREGVERIFY_OPTION_DISABLE" />
				<param name="rl_ip_short_window_min" type="int" default="15" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_IP_SHORT_WINDOW_MIN_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_IP_SHORT_WINDOW_MIN_DESC" />
				<param name="rl_ip_short_max" type="int" default="5" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_IP_SHORT_MAX_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_IP_SHORT_MAX_DESC" />
				<param name="rl_ip_day_window_hours" type="int" default="24" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_IP_DAY_WINDOW_HOURS_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_IP_DAY_WINDOW_HOURS_DESC" />
				<param name="rl_ip_day_max" type="int" default="25" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_IP_DAY_MAX_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_IP_DAY_MAX_DESC" />
			</tabpanetab>
			<tabpanetab label="CBBEFOREREGVERIFY_TAB_EMAIL_RATE_LIMITS">
				<param name="rl_email_enabled" type="yesno" default="1" label="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_ENABLED_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_ENABLED_DESC" yes="CBBEFOREREGVERIFY_OPTION_ENABLE" no="CBBEFOREREGVERIFY_OPTION_DISABLE" />
				<param name="rl_email_short_window_min" type="int" default="30" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_SHORT_WINDOW_MIN_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_SHORT_WINDOW_MIN_DESC" />
				<param name="rl_email_short_max" type="int" default="3" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_SHORT_MAX_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_SHORT_MAX_DESC" />
				<param name="rl_email_day_window_hours" type="int" default="24" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_DAY_WINDOW_HOURS_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_DAY_WINDOW_HOURS_DESC" />
				<param name="rl_email_day_max" type="int" default="10" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_DAY_MAX_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_EMAIL_DAY_MAX_DESC" />
			</tabpanetab>
			<tabpanetab label="CBBEFOREREGVERIFY_TAB_RESEND_AND_ATTEMPTS">
				<param name="rl_resend_enabled" type="yesno" default="1" label="CBBEFOREREGVERIFY_PARAM_RL_RESEND_ENABLED_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_RESEND_ENABLED_DESC" yes="CBBEFOREREGVERIFY_OPTION_ENABLE" no="CBBEFOREREGVERIFY_OPTION_DISABLE" />
				<param name="rl_resend_cooldown_sec" type="int" default="60" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_RESEND_COOLDOWN_SEC_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_RESEND_COOLDOWN_SEC_DESC" />
				<param name="rl_attempts_enabled" type="yesno" default="1" label="CBBEFOREREGVERIFY_PARAM_RL_ATTEMPTS_ENABLED_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_ATTEMPTS_ENABLED_DESC" yes="CBBEFOREREGVERIFY_OPTION_ENABLE" no="CBBEFOREREGVERIFY_OPTION_DISABLE" />
				<param name="rl_attempts_max" type="int" default="8" size="5" label="CBBEFOREREGVERIFY_PARAM_RL_ATTEMPTS_MAX_LABEL" description="CBBEFOREREGVERIFY_PARAM_RL_ATTEMPTS_MAX_DESC" />
			</tabpanetab>
		</tabpane>
	</params>
	<database version="1">
		<table name="#__comprofiler_plugin_beforeregverify" class="\CB\Plugin\BeforeRegVerify\Table\VerificationTable" strict="true" drop="never">
			<columns strict="true" drop="never">
				<column name="id" type="sql:int(11)" unsigned="true" auto_increment="1" />
				<column name="email" type="sql:varchar(255)" />
				<column name="code_hash" type="sql:varchar(255)" null="true" />
				<column name="status" type="sql:varchar(16)" />
				<column name="outcome" type="sql:varchar(16)" />
				<column name="ttl" type="sql:int(10)" unsigned="true" />
				<column name="sent_at" type="sql:datetime" />
				<column name="modified_at" type="sql:datetime" />
				<column name="request_ip" type="sql:varchar(45)" null="true" />
				<column name="note" type="sql:text" null="true" />
			</columns>
			<indexes strict="true" drop="always">
				<index name="PRIMARY" type="primary">
					<column name="id" />
				</index>
				<index name="email_outcome">
					<column name="email" />
					<column name="outcome" />
				</index>
				<index name="email_status_outcome_sent_at">
					<column name="email" />
					<column name="status" />
					<column name="outcome" />
					<column name="sent_at" />
				</index>
				<index name="outcome">
					<column name="outcome" />
				</index>
				<index name="sent_at">
					<column name="sent_at" />
				</index>
				<index name="modified_at">
					<column name="modified_at" />
				</index>
				<index name="request_ip_sent_at">
					<column name="request_ip" />
					<column name="sent_at" />
				</index>
			</indexes>
			<engine type="InnoDB" sameastable="#__comprofiler" strict="updatewithtable" />
		</table>
	</database>
</cbinstall>
